{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "object",
      "required": ["challenge", "tick", "science", "review"],
      "properties": {
        "challenge": {"$ref": "#/$defs/route"},
        "tick": {"$ref": "#/$defs/route"},
        "science": {"$ref": "#/$defs/route"},
        "review": {"$ref": "#/$defs/route"}
      },
      "additionalProperties": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["provider", "model", "effort"],
      "properties": {
        "provider": {"enum": ["anthropic", "openai"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
