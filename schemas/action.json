{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {"enum": ["move", "gather", "build", "demolish", "say", "whisper", "write", "give", "take", "eat", "post_goal", "claim_goal", "confirm_goal", "cancel_goal", "abandon_goal", "found_faction", "join_faction", "leave_faction", "set_profile", "remember", "forget"]},
    "x": {"type": "integer", "minimum": 0, "maximum": 127},
    "y": {"type": "integer", "minimum": 0, "maximum": 127},
    "text": {"type": "string", "maxLength": 2000},
    "to": {"type": "string", "maxLength": 24},
    "qty": {"type": "integer", "minimum": 1},
    "item": {"enum": ["wood", "stone", "ore", "fiber", "berries"]},
    "kind": {"enum": ["wood", "stone", "ore", "fiber", "berries"]},
    "type": {"type": "string"},
    "title": {"type": "string", "minLength": 3, "maxLength": 80},
    "description": {"type": "string", "maxLength": 1000}
  },
  "additionalProperties": true
}
