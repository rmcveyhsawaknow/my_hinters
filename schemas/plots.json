{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Land office ledger: the registrar persona, the plot grid, the posted fee, standing offers and pre-registered plots",
  "type": "object",
  "required": ["registrar", "grid", "fee", "fee_reward", "registration_title", "offers", "plots"],
  "additionalProperties": false,
  "properties": {
    "registrar": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
    "grid": {"type": "integer", "minimum": 5, "maximum": 32},
    "fee": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 50}},
    "fee_reward": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "registration_title": {"type": "string", "minLength": 3, "maxLength": 80},
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "want", "reward"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "want": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 50}},
          "reward": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
          "status": {"enum": ["open", "parked"]}
        }
      }
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "holder", "since"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-M][0-9]{2}$"},
          "holder": {"type": "string"},
          "since": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
