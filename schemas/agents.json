{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "enabled", "roles", "runtime"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{3,24}$"},
          "enabled": {"type": "boolean"},
          "roles": {"type": "array", "items": {"type": "string"}},
          "runtime": {"enum": ["claude-code", "codex", "copilot", "actions-anthropic", "actions-openai", "human"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
