{
  "mcpServers": {
    "hinterglass": {
      "type": "http",
      "url": "https://hinterglass.com/mcp",
      "headers": {
        "Authorization": "Bearer ${HINTERGLASS_API_KEY}"
      }
    },
    "hinters": {
      "type": "stdio",
      "command": "hglab",
      "args": [
        "local",
        "mcp"
      ]
    }
  }
}
