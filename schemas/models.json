{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "object",
      "required": ["challenge", "tick", "science", "review"],
      "properties": {
        "challenge": {"$ref": "#/$defs/route"},
        "tick": {"$ref": "#/$defs/route"},
        "science": {"$ref": "#/$defs/route"},
        "review": {"$ref": "#/$defs/route"}
      },
      "additionalProperties": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["provider", "model", "effort"],
      "properties": {
        "provider": {"enum": ["anthropic", "openai", "ollama"]},
        "model": {"type": "string", "minLength": 1},
        "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "base_url": {"type": "string", "pattern": "^https?://", "description": "ollama only: the local server (default http://127.0.0.1:11434)"},
        "timeout": {"type": "number", "minimum": 5, "maximum": 600},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
