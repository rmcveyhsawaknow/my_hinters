{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team definition",
  "type": "object",
  "required": ["slug", "name", "aim", "members", "home", "territory", "social_budget", "links"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 60},
    "aim": {"type": "string", "minLength": 10, "maxLength": 400},
    "pipeline": {
      "type": "object",
      "description": "The team's materials pipeline: the works' site and radius, how far hands range, the stock the factory stores should hold, and the structures to raise in order.",
      "required": ["site", "plan"],
      "additionalProperties": false,
      "properties": {
        "site": {"type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": {"x": {"type": "integer", "minimum": 0, "maximum": 127}, "y": {"type": "integer", "minimum": 0, "maximum": 127}}},
        "radius": {"type": "integer", "minimum": 2, "maximum": 20},
        "range": {"type": "integer", "minimum": 4, "maximum": 128},
        "stock": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "floor": {"type": "integer", "minimum": 0, "maximum": 10, "description": "Nodes are worked down to this many units (the collective's floor of five by default)."},
        "claims": {
          "type": "object",
          "description": "The land office's holdings: the registrar's best staked lots, worked first by the hands.",
          "required": ["registrar"],
          "additionalProperties": false,
          "properties": {
            "registrar": {"type": "string", "minLength": 3, "maxLength": 24},
            "keep": {"type": "integer", "minimum": 0, "maximum": 200},
            "always_ore": {"type": "boolean"},
            "depots": {"type": "integer", "minimum": 0, "maximum": 10},
            "floor": {"type": "integer", "minimum": 0, "maximum": 10},
            "protect_spawn": {"type": "integer", "minimum": 0, "maximum": 40},
            "protect_homesteads": {"type": "boolean"},
            "exclude": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][0-9]{2}-(NW|NE|SW|SE)$"}, "uniqueItems": true, "description": "Staked lots under contract to a client (a site request): never holdings, never worked"},
            "text": {"type": "string", "minLength": 10, "maxLength": 160},
            "walls": {
              "type": "object", "additionalProperties": false,
              "description": "Walls on the staked lots (owner, 2026-10-25): when every office store is full the hands wall the lots with the stone, the middle of every side left open as a gate (hglab.walls)",
              "properties": {
                "enabled": {"type": "boolean"},
                "scope": {"enum": ["holdings", "staked"], "description": "holdings: the holdings only; staked: the holdings first, then every other staked lot"}
              }
            },
            "evict": {
              "type": "object", "additionalProperties": false,
              "description": "What others build on a staked lot without buying or registering it is taken down by the hands, after the registrar's whispered notice (owner, 2026-10-25; hglab.evict)",
              "properties": {
                "enabled": {"type": "boolean"},
                "notice_ticks": {"type": "integer", "minimum": 0, "maximum": 60480, "description": "Ticks between the notice and the first hit (360 is one real hour)"}
              }
            }
          }
        },
        "stores_max": {"type": "integer", "minimum": 1, "maximum": 12, "description": "Storehouses at the works before the hands stop raising more for a full stock (default 6)"},
        "blueprint": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$", "description": "The team's block design in teams/blueprints/<name>.yaml (hglab.factory)"},
        "builders": {"type": "object", "description": "Personas who place the blueprint, each with the sections it raises first", "additionalProperties": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"}}},
        "plan": {"type": "array", "maxItems": 20, "items": {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {
          "type": {"enum": ["sign", "road", "wall", "bridge", "hut", "farm", "storehouse", "tower", "monument"]},
          "count": {"type": "integer", "minimum": 1, "maximum": 40},
          "text": {"type": "string", "maxLength": 200}}}}
      }
    },
    "faction": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Za-z0-9 _-]+$"},
        "motto": {"type": "string", "maxLength": 120},
        "membership": {"enum": ["invite", "open"]}, "precedence": {"enum": ["team", "theme"], "description": "team (default): a member found in another faction leaves it for this one; theme: members may keep a collector theme."},
        "founder": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
        "exempt": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}, "uniqueItems": true},
        "allies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}, "uniqueItems": true, "description": "Personas of other teams the founder invites too; they may take from the faction's stores"}
      }
    },
    "story": {"type": "string", "maxLength": 1200},
    "members": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}, "uniqueItems": true},
    "home": {
      "type": ["object", "null"],
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer", "minimum": 0, "maximum": 127},
        "y": {"type": "integer", "minimum": 0, "maximum": 127},
        "status": {"enum": ["proposed", "confirmed"]},
        "note": {"type": "string", "maxLength": 300}
      },
      "additionalProperties": false
    },
    "territory": {
      "type": ["object", "null"],
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["circle", "rect"]},
        "x": {"type": "integer", "minimum": 0, "maximum": 127},
        "y": {"type": "integer", "minimum": 0, "maximum": 127},
        "radius": {"type": "integer", "minimum": 1, "maximum": 64},
        "x0": {"type": "integer", "minimum": 0, "maximum": 127},
        "y0": {"type": "integer", "minimum": 0, "maximum": 127},
        "x1": {"type": "integer", "minimum": 0, "maximum": 127},
        "y1": {"type": "integer", "minimum": 0, "maximum": 127},
        "status": {"enum": ["proposed", "confirmed"]},
        "note": {"type": "string", "maxLength": 300}
      },
      "additionalProperties": false
    },
    "border": {
      "type": "object",
      "description": "Signs along the territory's edge, each with its own words, and the one opening visitors are told of.",
      "required": ["signs", "entrance"],
      "properties": {
        "signs": {
          "type": "array", "minItems": 1, "maxItems": 24,
          "items": {
            "type": "object", "required": ["x", "y", "text"],
            "properties": {
              "x": {"type": "integer", "minimum": 0, "maximum": 127},
              "y": {"type": "integer", "minimum": 0, "maximum": 127},
              "text": {"type": "string", "minLength": 10, "maxLength": 200}
            },
            "additionalProperties": false
          }
        },
        "entrance": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "social_budget": {
      "type": "object",
      "required": ["says_per_hour"],
      "properties": {
        "says_per_hour": {"type": "integer", "minimum": 1, "maximum": 12},
        "open_goals": {"type": "integer", "minimum": 1, "maximum": 8}
      },
      "additionalProperties": false
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "signal", "to", "effect", "plain_english"],
        "properties": {
          "from": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
          "signal": {"type": "string", "pattern": "^[a-z_]+$"},
          "to": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
          "effect": {"type": "string", "pattern": "^[a-z_]+$"},
          "plain_english": {"type": "string", "minLength": 10, "maxLength": 300},
          "half_life_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 720},
          "weight": {"type": "number", "minimum": -1, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
