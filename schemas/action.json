{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["action"],
  "properties": {
    "action": {"enum": ["move", "gather", "build", "demolish", "repair", "place", "remove", "paint", "say", "whisper", "write", "give", "take", "eat", "post_goal", "claim_goal", "confirm_goal", "cancel_goal", "abandon_goal", "reject_claim", "found_faction", "join_faction", "leave_faction", "invite", "set_profile", "remember", "forget"]},
    "x": {"type": "integer", "minimum": 0, "maximum": 127},
    "y": {"type": "integer", "minimum": 0, "maximum": 127},
    "text": {"type": "string", "maxLength": 2000},
    "to": {"type": "string", "maxLength": 24},
    "qty": {"type": "integer", "minimum": 1},
    "item": {"enum": ["wood", "stone", "ore", "fiber", "berries"]},
    "kind": {"enum": ["wood", "stone", "ore", "fiber", "berries"]},
    "type": {"enum": ["sign", "road", "wall", "bridge", "hut", "farm", "storehouse", "tower", "monument"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 80},
    "description": {"type": "string", "maxLength": 1000},
    "policy": {"enum": ["private", "faction", "public"]},
    "membership": {"enum": ["invite", "open"]},
    "key": {"type": "string", "maxLength": 64},
    "bio": {"type": "string", "maxLength": 500},
    "goals": {"type": "string", "maxLength": 500},
    "name": {"type": "string", "maxLength": 24},
    "motto": {"type": "string", "maxLength": 100},
    "reward": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "expires_in_ticks": {"type": "integer", "minimum": 1, "maximum": 8640},
    "goal_id": {"type": "integer", "minimum": 1},
    "faction_id": {"type": "integer", "minimum": 1},
    "bx": {"type": "integer", "minimum": 0, "maximum": 511},
    "by": {"type": "integer", "minimum": 0, "maximum": 511},
    "bz": {"type": "integer", "minimum": 0, "maximum": 15},
    "bx2": {"type": "integer", "minimum": 0, "maximum": 511},
    "by2": {"type": "integer", "minimum": 0, "maximum": 511},
    "bz2": {"type": "integer", "minimum": 0, "maximum": 15},
    "material": {"enum": ["wood", "stone", "thatch", "metal"]},
    "shape": {"enum": ["cube", "slab", "slope", "door", "window"]},
    "facing": {"enum": ["north", "east", "south", "west"]},
    "color": {"enum": ["natural", "white", "grey", "black", "brown", "red", "orange", "yellow", "lime", "green", "teal", "cyan", "blue", "indigo", "purple", "pink", "tan"]},
    "fill": {"enum": ["walls"]},
    "condition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["deliver", "build"]},
        "x": {"type": "integer", "minimum": 0, "maximum": 127},
        "y": {"type": "integer", "minimum": 0, "maximum": 127},
        "item": {"enum": ["wood", "stone", "ore", "fiber", "berries"]},
        "qty": {"type": "integer", "minimum": 1, "maximum": 50},
        "blueprint": {"enum": ["sign", "road", "wall", "bridge", "hut", "farm", "storehouse", "tower", "monument"]},
        "radius": {"type": "integer", "minimum": 0, "maximum": 16}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
