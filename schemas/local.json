{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local agents framework configuration",
  "type": "object",
  "required": ["agents"],
  "additionalProperties": false,
  "properties": {
    "dry_run": {"type": "boolean"},
    "a2a_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "ui_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
        "data_boundary": {"enum": ["public", "internal", "restricted"]},
        "backup_target": {"type": "string", "pattern": "^(local:.+|gs://[a-z0-9][a-z0-9._-]+(/.*)?)$"},
        "backup_every_minutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "auth": {"enum": ["service_account", "gcloud"]}
      }
    },
    "nemoclaw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "wsl_distro": {"type": "string"},
        "ollama": {"type": "boolean"}
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug"],
        "additionalProperties": false,
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
          "enabled": {"type": "boolean"},
          "dry_run": {"type": "boolean"},
          "jobs": {"type": "array", "items": {"enum": ["tick", "shift", "keepalive", "crier", "land"]}, "uniqueItems": true}
        }
      }
    }
  }
}
