{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Land office ledger: the registrar persona, the plot grid, the posted fee, standing offers and pre-registered plots",
  "type": "object",
  "required": ["registrar", "grid", "fee", "fee_reward", "registration_title", "offers", "plots", "lots"],
  "additionalProperties": false,
  "properties": {
    "registrar": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
    "grid": {"type": "integer", "minimum": 5, "maximum": 32},
    "fee": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 50}},
    "fee_reward": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "registration_title": {"type": "string", "minLength": 3, "maxLength": 80},
    "site_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "client"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
          "client": {"type": "string", "minLength": 3, "maxLength": 24},
          "size": {"type": "integer", "enum": [5]},
          "expandable": {"type": "integer", "minimum": 0, "maximum": 4},
          "min_buildable": {"type": "integer", "minimum": 1, "maximum": 25},
          "wants": {"type": "array", "items": {"enum": ["wood", "stone", "ore", "fiber", "berries"]}},
          "near": {"type": "array", "items": {"type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": {"label": {"type": "string", "maxLength": 40}, "x": {"type": "integer"}, "y": {"type": "integer"}, "weight": {"type": "number", "minimum": 0, "maximum": 10}, "max": {"type": "integer", "minimum": 1, "maximum": 128}}}},
          "prefer": {"type": "object", "additionalProperties": false, "properties": {"y_min": {"type": "integer"}, "y_max": {"type": "integer"}}},
          "lots": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][0-9]{2}-(NW|NE|SW|SE)$"}, "description": "A fixed survey: the client's own ground, these lots priced by their worth, no search"},
          "note": {"type": "string", "maxLength": 300}
        }
      }
    },
    "lots": {
      "type": "object",
      "required": ["size", "currency", "base_price", "price_cap", "sale_title", "sale_reward"],
      "additionalProperties": false,
      "properties": {
        "size": {"type": "integer", "enum": [5]},
        "currency": {"enum": ["wood", "stone", "ore", "fiber", "berries"]},
        "base_price": {"type": "integer", "minimum": 1, "maximum": 50},
        "price_cap": {"type": "integer", "minimum": 1, "maximum": 50},
        "sale_title": {"type": "string", "minLength": 3, "maxLength": 80},
        "sale_reward": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "sales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sell", "price"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "sell": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 50}},
          "price": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 50}},
          "min_stock": {"type": "integer", "minimum": 0, "maximum": 500},
          "status": {"enum": ["open", "parked"]}
        }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "want", "reward"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "want": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 50}},
          "reward": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
          "status": {"enum": ["open", "parked"]}
        }
      }
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "holder", "since"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-M][0-9]{2}$"},
          "holder": {"type": "string"},
          "since": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
